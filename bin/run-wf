#!/usr/bin/env bash
#./bin/run-wf 
set -euo pipefail

# Usage: ./bin/run-wf  [workflow]
# or:    WF=build ./bin/run-wf

# Who calls this scritp:
# bin/run_and_capture.sh



WF="${1:-${WF:-smoke}}"
echo "[wf] starting workflow '$WF' at $(date -u +%Y-%m-%dT%H:%M:%SZ)"

case "$WF" in

  # Does the test workflow all unit tests or can it just be 
  # a smoke test? It would depend on what target was being executed.
  smoke)
    echo "[wf] running tests"
    make -f hunchly.mk smoke-test
    make -f hunchly.mk smoke-playback

    # Tests should assert basic pre-conditions or unit behavior?
    #pytest -q || true
    ;;
  test) 
      pytest -q  
    ;;  
  build)
    echo "[wf] building project"
    make build  
    ;;
  ci)
    echo "[wf] CI smoke test"
    ./scripts/ci_smoke.sh  
    ;;
  analysis)
    echo "[wf] static analysis"
    ./tools/analyze.sh || true
    ;;
  *)
    echo "[wf] unknown workflow: '$WF'"
    echo "Usage: ./bin/run-wf.sh [tests|build|ci|analysis]"
    exit 2
    ;;
esac

echo "[wf] finished workflow '$WF' at $(date -u +%Y-%m-%dT%H:%M:%SZ)"
